node_modules
dist
dist-ssr
.vite
*.local
.DS_Store

# playwright-mcp test artifacts
.playwright-mcp/

# Agent context & local-only docs (init-scaffold / init-agent-context)
LLM_RULES.md
.claude/

# Obsidian vault runtime state
docs/.obsidian/

# Agent boot symlink (scaffold-llm-context)
LLM_RULES.md

# Ephemeral agent loop state (kol-goal).
# Glob, not the bare name: goal files are per-session as of 2026-08-15
# (.active-goal-<session_id>.md), so an exact-name rule would leave every
# new one untracked-but-visible. .gitignore has no trailing comments —
# a `#` only starts one at the beginning of a line.
.kol/llm-context/.active-goal*.md
_tmp/

# The D1 Worker's local secret (plan 07) — ADMIN_PASSWORD for `wrangler dev`; the deployed one is `wrangler secret put`
api/.dev.vars

# wrangler's local dev state for the Worker (local D1 copy + cache) — regenerated by `pnpm dev`
api/.wrangler/
