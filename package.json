{
  "name": "kol-fxr",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --force",
    "build": "vite build",
    "build:lib": "vite build --config vite.lib.config.js",
    "preview": "vite preview",
    "api:dev": "wrangler dev --config api/wrangler.toml --port 8787",
    "api:schema": "wrangler d1 execute kol-fxr --remote --file api/schema.sql --config api/wrangler.toml",
    "api:schema:local": "wrangler d1 execute kol-fxr --local --file api/schema.sql --config api/wrangler.toml",
    "api:deploy": "wrangler deploy --config api/wrangler.toml"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "colord": "^2.9.3",
    "d3-delaunay": "^6.0.4",
    "d3-force": "^3.0.0",
    "mediabunny": "^1.54.0",
    "opentype.js": "^2.0.0",
    "paper": "^0.12.18",
    "pixi-filters": "^6.1.5",
    "pixi.js": "^8.19.0",
    "simplex-noise": "^4.0.3",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@kolkrabbi/kol-brand": "0.1.3",
    "@kolkrabbi/kol-component": "0.241.0",
    "@kolkrabbi/kol-framework": "0.49.0",
    "@kolkrabbi/kol-icons": "0.33.1",
    "@kolkrabbi/kol-media-client": "0.4.1",
    "@kolkrabbi/kol-shell": "0.62.0",
    "@kolkrabbi/kol-theme": "0.167.0",
    "@vitejs/plugin-react": "^6.0.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "vite": "^8.2.1",
    "vite-plugin-svgr": "^5.2.0",
    "wrangler": "^4.148.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
